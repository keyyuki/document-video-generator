{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kịch bản một tập Hồ Sơ Sử Việt",
  "type": "object",
  "required": ["id", "segments"],
  "properties": {
    "intro": { "type": "object", "description": "Đoạn mở đầu thương hiệu (trang giấy, viết tên vụ án, đóng dấu)", "required": ["title"], "properties": { "after": { "type": "string" }, "number": { "type": "integer" }, "title": { "type": "string" }, "subtitle": { "type": "string" }, "meta": { "type": "string" }, "stamp": { "type": "string" }, "enabled": { "type": "boolean" } } }
  },
  "$defs": {
    "position": {
      "properties": {
        "cue": { "type": "string", "description": "Cụm từ trong lời đọc (bắt đầu tại đó) hoặc \"@pause\" (đầu quãng nghỉ)" },
        "at": { "type": "number", "description": "Giây tính từ lúc bắt đầu nói đoạn này" },
        "offset": { "type": "number", "description": "Cộng thêm (giây, có thể âm)" }
      }
    },
    "overlay": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["stamp", "caption", "center", "lowerThird", "list", "endCard", "quote", "timeline", "route"] },
        "source": { "type": "string", "description": "quote: nguồn trích" },
        "points": { "type": "array", "description": "route: điểm trên bản đồ, x/y là % khung hình", "items": { "type": "object", "required": ["x", "y", "label"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "label": { "type": "string" } } } },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "text": { "type": "string" },
        "label": { "type": "string" },
        "items": { "type": "array", "description": "list: chuỗi; timeline: {date, text}", "items": { "type": ["string", "object"] } },
        "at": { "type": "number" },
        "duration": { "type": "number" },
        "color": { "type": "string" }
      }
    },
    "fx": {
      "type": "object",
      "properties": {
        "rain": { "type": "number", "minimum": 0, "maximum": 3 },
        "rainAngle": { "type": "number" },
        "fire": { "type": "array", "items": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "radius": { "type": "number" } } } },
        "embers": { "type": "boolean" },
        "grain": { "type": "number", "minimum": 0, "maximum": 0.3 }
      }
    },
    "shot": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/position" }],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["image", "clip", "card", "intro"], "default": "image" },
        "prompt": { "type": "string" },
        "library": { "type": "string" },
        "asset": { "type": "string" },
        "chars": { "type": "array", "items": { "type": "string" } },
        "motion": { "enum": ["zoomIn", "zoomOut", "panLeft", "panRight", "panUp", "panDown", "still", "focusIn", "focusOut"] },
        "focus": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "focusIn/focusOut: điểm nhấn [x%, y%]" },
        "focusTo": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "zoom": { "type": "number", "description": "độ phóng của focusIn/focusOut (mặc định 1,5)" },
        "overlay": { "$ref": "#/$defs/overlay" },
        "fx": { "$ref": "#/$defs/fx" },
        "clipSeconds": { "type": "number" },
        "startFrom": { "type": "string" },
        "trimBefore": { "type": "number" },
        "playbackRate": { "type": "number", "minimum": 0.25, "maximum": 2 },
        "fit": { "type": "boolean" }
      }
    },
    "sfx": {
      "type": "object",
      "required": ["name"],
      "allOf": [{ "$ref": "#/$defs/position" }],
      "properties": { "name": { "type": "string" }, "gain": { "type": "number" } }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "music": { "type": ["string", "null"] },
    "musicVolume": { "type": "number" },
    "overrides": { "type": "object", "description": "Ghi đè config/series.yaml cho riêng tập này" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "voice": { "type": "string" },
          "pause": { "type": "number", "minimum": 0 },
          "sfx": { "type": "array", "items": { "$ref": "#/$defs/sfx" } },
          "shots": { "type": "array", "items": { "$ref": "#/$defs/shot" } }
        }
      }
    }
  }
}
